{
  "rules": {
    ".read": "auth != null || true",
    ".write": "auth != null || true",
    "device_logs": {
      "": {
        ".indexOn": ["timestamp", "logType", "severity"],
        "": {
          ".validate": "newData.hasChildren(['timestamp', 'logType'])"
        }
      }
    },
    "pairing_invites": {
      ".indexOn": ["status", "sponsorCode", "expiresAt", "seekerPhone"],
      "": {
        ".validate": "newData.hasChildren(['inviteCode', 'sponsorCode', 'seekerName', 'expiresAt', 'status'])"
      }
    },
    "profiles": {
      ".indexOn": ["referenceCode", "referredByCode", "profileType", "isActive", "paymentStatus"]
    },
    "authorisedNodes": {
      ".indexOn": ["nodeId", "sponsorId", "role", "status", "lastSeenTimestamp"]
    },
    "sync_queue": {
      "": {
        ".indexOn": ["timestamp", "status", "revision"]
      }
    },
    "lineage_graph": {
      ".indexOn": ["rootCode", "parentCode", "childCode"]
    }
  }
}